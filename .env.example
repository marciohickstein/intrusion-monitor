# Copie para .env (desenvolvimento). Em producao estas variaveis ficam em
# /etc/intrusion-monitor.env, carregado pelo systemd.
PORT=3100
HOST=127.0.0.1
NODE_ENV=development

ADMIN_USER=admin
# Gere com: npm run hash-password
ADMIN_PASSWORD_HASH='$2b$12$troque.este.hash.................................'
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Fontes de dados (padroes do Ubuntu)
SSH_SINCE=7 days ago
UFW_LOG=/var/log/ufw.log
FAIL2BAN_LOG=/var/log/fail2ban.log
NGINX_ACCESS_LOG=/var/log/nginx/access.log
FAIL2BAN_JAIL=sshd
# Container do nginx do hash-generator (docker ps --format '{{.Names}}')
FRONTEND_CONTAINER=hash-generator-frontend-1
# Quanto ler do fim de cada arquivo de log
MAX_LOG_BYTES=10485760
# Usa dados de exemplo em vez de ler o servidor (para desenvolver localmente)
DEMO_MODE=false
